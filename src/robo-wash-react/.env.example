# Ключ 2GIS MapGL. Скопируйте файл в .env и вставьте свой ключ — .env в репозиторий не коммитим.
VITE_2GIS_MAP_KEY=

# Адрес API. Локально оставьте пустым: запросы пойдут относительным путём через прокси Vite
# на http://localhost:5287. В Cloud Run сюда подставляется адрес сервиса robo-wash-api.
VITE_API_BASE_URL=
