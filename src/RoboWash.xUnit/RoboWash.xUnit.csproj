<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoboWash.Api\RoboWash.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Скрипт едет в выходную папку, а оттуда в контейнер: базу тестам разворачивает ровно тот файл,
         который лежит в репозитории и описан в README. -->
    <None Include="..\..\db\create-database.sql" Link="create-database.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
